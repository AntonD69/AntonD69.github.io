{
  "name": "static-framework",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node build-scripts/fetch-sheets.mjs",
    "fetch:geocaches": "node build-scripts/fetch-sheets.mjs geocaches",
    "fetch:parkruns": "node build-scripts/fetch-sheets.mjs parkruns",
    "fetch:places-been": "node build-scripts/fetch-sheets.mjs places-been",
    "fetch:keyrings": "node build-scripts/fetch-sheets.mjs keyrings",
    "fetch:other-adventures": "node build-scripts/fetch-sheets.mjs other-adventures",
    "fetch:panoramas": "node build-scripts/fetch-sheets.mjs panoramas",
    "fetch:photo-albums": "node build-scripts/fetch-sheets.mjs photo-albums",
    "fetch:all": "node build-scripts/fetch-sheets.mjs",

	"fetch-build": "npm run fetch:all && npm run build",

	"fetch-build-run": "npm run fetch:all && npm run build-run",

	"build": "node build-scripts/build.js",
	"build-strict": "node build-scripts/build.js --strict",
	"build-run": "npm run build && npm run run",
	"build-run:page": "npm run build && npm run run:page-i",

	
	"run": "npx vite preview --outDir dist --open",
	"run:page": "npx vite preview --outDir dist --open /workshop-keyrings.html",
	"run:page-i": "npx vite preview --outDir dist --open /panorama-index.html",

	"fetch-build-run:page": "npm run fetch-build  && npm run run:page-i",
	"fetch-build-run:panorama": "npm run fetch:panoramas && npm run build && npx vite preview --outDir dist --open /panorama-index.html",

	"panoramas:convert": "node build-scripts/panoramas-convert.mjs",
	"panoramas:copy-into-project": "node build-scripts/panoramas-copy-into-project.mjs"
},
  "devDependencies": {
    "glob": "^13.0.6",
    "sharp": "^0.35.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-parser": "^3.2.1",
    "node-fetch": "^3.3.2"
  }
}
