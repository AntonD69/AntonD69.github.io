{
  "name": "static-framework",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:all": "node build-scripts/fetch-sheet-geocaches.mjs &&  node build-scripts/fetch-sheet-parkruns.mjs && node build-scripts/fetch-sheet-places-been.mjs",
    "copy:geocache-files": "node build-scripts/copy-geocache-files.js",
    "fetch:geocaches": "node build-scripts/fetch-sheet-geocaches.mjs",
    "fetch:parkruns": "node build-scripts/fetch-sheet-parkruns.mjs",
    "fetch:places-been": "node build-scripts/fetch-sheet-places-been.mjs",
    "generate": "npm run fetch:all && node build-scripts/build.js",
    "dev": "npm run generate",
    "build": "npm run generate"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-parser": "^3.2.1",
    "node-fetch": "^3.3.2"
  }
}
